{
  "name": "rainknights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "art:generate": "node --env-file=.env scripts/generate-art.mjs",
    "capture": "playwright test",
    "test:unit": "vitest run",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "balance": "playwright test --config=playwright.balance.config.ts; node tools/balance/report.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
